<section class="sec bg-surface text-ink" id="{{ section.settings.anchor | default: 's04' }}">
  <div class="sec__in sec__in--tight py-[calc(var(--space-section)/2)]">
    <div class="wrap usp grid grid-cols-2 gap-0 sm:grid-cols-4">
      {%- for block in section.blocks -%}{% render 'usp-item', block: block %}{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits row",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s04" }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "heart", "label": "heart" }, { "value": "check-circle", "label": "check-circle" }, { "value": "location", "label": "location" }, { "value": "arrow-left", "label": "arrow-left" }, { "value": "bag", "label": "bag" }, { "value": "star", "label": "star" }, { "value": "check", "label": "check" }, { "value": "info", "label": "info" }, { "value": "account", "label": "account" }, { "value": "share", "label": "share" }, { "value": "eye", "label": "eye" }, { "value": "search", "label": "search" } ], "default": "heart" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "text", "id": "text", "label": "Text", "default": "Short supporting line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Benefits row", "blocks": [ { "type": "usp_item" }, { "type": "usp_item" }, { "type": "usp_item" }, { "type": "usp_item" } ] }
  ]
}
{% endschema %}
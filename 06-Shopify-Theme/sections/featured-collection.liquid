{%- assign tabs = section.blocks -%}
{%- assign limit = section.settings.products_to_show -%}
<section class="sec bg-page text-ink" id="{{ section.settings.anchor | default: 's06' }}">
  <div class="sec__in py-section">
    <div class="wrap">
      {% render 'section-heading', title: section.settings.heading %}
      {%- if tabs.size > 1 -%}
        <div class="tabs mb-6 flex flex-wrap justify-center gap-x-2 gap-y-1 sm:mb-8 lg:mb-10" role="tablist">
          {%- for block in tabs -%}{% render 'collection-tab', block: block, index0: forloop.index0, first: forloop.first %}{%- endfor -%}
        </div>
      {%- endif -%}      <div class="g--prod grid min-w-0 grid-cols-2 gap-x-3 gap-y-7 md:grid-cols-4 md:gap-x-grid-gap md:gap-y-10 [&>*]:min-w-0" id="prod-grid">
        {%- if tabs.size > 0 -%}
          {%- assign first_tab = tabs.first -%}
          {%- for product in first_tab.settings.collection.products limit: limit -%}{% render 'product-card-home', product: product, index0: forloop.index0 %}{%- endfor -%}
        {%- endif -%}
      </div>
      {%- for block in tabs -%}
        {%- unless forloop.first -%}
          <template data-tab-grid="{{ forloop.index0 }}">{%- for product in block.settings.collection.products limit: limit -%}{% render 'product-card-home', product: product, index0: forloop.index0 %}{%- endfor -%}</template>
        {%- endunless -%}
      {%- endfor -%}
      {%- if section.settings.button_label != blank -%}        <div class="mt-7 text-center sm:mt-10 lg:mt-12">{% render 'button-editorial', class: 'hp-btn hp-btn-o', url: section.settings.button_link, label: section.settings.button_label %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our favourites" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 2, "label": "Products per tab", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all best sellers" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s06" },
    { "type": "paragraph", "content": "Product details come from the product: price and compare-at price, a badge from a tag such as badge:Bestseller, size and highlight from the custom.size and custom.highlight metafields, rating from the reviews.rating and reviews.rating_count metafields." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Featured collection", "blocks": [ { "type": "tab", "settings": { "label": "Best sellers" } }, { "type": "tab", "settings": { "label": "New launches" } }, { "type": "tab", "settings": { "label": "Sets" } } ] }
  ]
}
{% endschema %}
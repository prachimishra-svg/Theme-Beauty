{%- assign methods = section.settings.payment_methods | newline_to_br | strip_newlines | split: '<br />' -%}
<footer class="bg-inverse text-ink-inverse">
  <div class="mx-auto grid w-full max-w-[calc(var(--container-max)+2*var(--layout-gutter))] gap-6 px-gutter py-section md:grid-cols-[minmax(0,10rem)_minmax(0,1fr)] md:gap-[calc(var(--space-10)+var(--space-1))] lg:grid-cols-[3fr_8fr] lg:gap-16">
    <div>
      <a href="{{ routes.root_url }}" class="mb-[14px] inline-flex min-h-touch items-center pr-2 text-ink-inverse">{%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 480 | image_tag: class: 'block max-w-full w-auto', height: settings.logo_height, alt: shop.name, loading: 'lazy' }}{%- else -%}<svg viewBox="0 0 520 100" role="img" aria-label="NUDGE" fill="currentColor" class="block max-w-full h-7 w-auto"><path d="M0 14H16V100H0ZM66 0H82V86H66ZM0 14H19L82 86H63Z"/><path d="M106 0H122V62A25 25 0 0 0 172 62V0H188V62A41 41 0 0 1 106 62Z"/><path fill-rule="evenodd" d="M212 0H252A50 50 0 0 1 252 100H212ZM228 16H252A34 34 0 0 1 252 84H228Z"/><path d="M378 42H426V58H378Z"/><path d="M450 0H520V16H466V42H510V58H466V84H520V100H450Z"/><path d="M410.4 25.9A42 42 0 1 0 418 50" fill="none" stroke="currentColor" stroke-width="16"/></svg>{%- endif -%}</a>
      {%- if section.settings.brand_text != blank -%}<p class="text-body-sm text-ink-inverse-secondary">{{ section.settings.brand_text | escape }}</p>{%- endif -%}
      {%- if section.settings.show_social -%}
        <div class="mt-4 flex flex-wrap gap-2">
          {%- if settings.social_instagram != blank -%}{% render 'social-link', label: 'Instagram', icon: 'instagram', url: settings.social_instagram %}{%- endif -%}
          {%- if settings.social_facebook != blank -%}{% render 'social-link', label: 'Facebook', icon: 'facebook', url: settings.social_facebook %}{%- endif -%}
          {%- if settings.social_youtube != blank -%}{% render 'social-link', label: 'YouTube', icon: 'youtube', url: settings.social_youtube %}{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="md:grid md:grid-cols-[repeat(4,auto)] md:justify-between md:gap-grid-gap xl:grid-cols-4 xl:justify-normal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}{% render 'footer-column', block: block %}{%- endif -%}
      {%- endfor -%}
    </div>
    <div class="flex flex-col items-start gap-4 border-t border-line-inverse-subtle pt-5 md:col-span-full md:flex-row md:flex-wrap md:items-center md:justify-between">
      {%- if methods.size > 0 -%}
        <div class="flex flex-wrap gap-2" role="group" aria-label="{{ 'footer.payment_methods' | t }}">{%- for method in methods -%}<i class="border border-line-inverse-subtle px-3 py-1 text-caption font-medium not-italic text-ink-inverse-secondary">{{ method | strip | escape }}</i>{%- endfor -%}</div>
      {%- endif -%}
      {%- if section.settings.trust_text != blank -%}<div class="text-body-sm text-ink-inverse-secondary">{{ section.settings.trust_text | escape }}</div>{%- endif -%}
      {%- if section.settings.show_back_to_top -%}{% render 'back-to-top' %}{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Brand line", "default": "One line about the brand." },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true, "info": "Links are set under Theme settings > Social media." },
    { "type": "textarea", "id": "payment_methods", "label": "Payment methods", "default": "Visa\nMastercard\nUPI\nWallet", "info": "One per line." },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "Secure checkout. Easy returns. Support when you need it." },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back to top", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
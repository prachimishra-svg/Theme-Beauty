{%- assign prev_label = 'sections.testimonials.previous' | t -%}
{%- assign next_label = 'sections.testimonials.next' | t -%}
{%- assign region_label = 'sections.testimonials.region' | t -%}
<section class="sec bg-surface text-ink" id="{{ section.settings.anchor | default: 's14' }}">
  <div class="sec__in py-section">
    <div class="wrap">
      {% render 'section-heading', title: section.settings.heading %}
      <div class="rec group relative grid grid-cols-[minmax(0,1fr)] gap-4 [grid-template-areas:'nav'_'track']" data-scroller>
        {% render 'scroller-controls', hook: 'rec', prev: prev_label, next: next_label, end: true %}
        <ul class="rec__track m-0 flex list-none gap-4 overflow-x-auto overscroll-x-contain scroll-smooth p-0 [grid-area:track] [scroll-snap-type:x_mandatory] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:gap-6 [&>li]:flex-[0_0_85%] [&>li]:snap-start sm:[&>li]:basis-[calc((100%_-_16px)/2)] md:[&>li]:basis-[calc((100%_-_24px)/2)] lg:[&>li]:basis-[calc((100%_-_48px)/3)]" aria-label="{{ region_label }}" tabindex="0">
          {%- for block in section.blocks -%}{% render 'review-card', block: block, rating: section.settings.rating %}{%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars shown on each review", "default": 5, "info": "Reviews are written here by the merchant. For live reviews connect a review app later." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s14" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Easy to find what I needed, and it arrived quickly." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "text", "id": "product_label", "label": "Product link text" },
        { "type": "url", "id": "product_link", "label": "Product link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Testimonials", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
{%- liquid
  assign anchor = section.settings.anchor | default: 's03'
  assign prod = section.settings.featured_product
  assign f_title = section.settings.featured_title
  assign f_meta = section.settings.featured_meta
  assign f_url = section.settings.featured_url | default: '#s06'
  if prod != blank
    assign f_title = prod.title
    assign f_meta = prod.price | money
    assign f_url = prod.url
  endif
  assign f_meta_spoken = f_meta | replace: ' · ', ', '
-%}
<section class="sec group relative z-0 flex flex-col bg-page text-ink [--scrim:80] [--stage:clamp(460px,64svh,600px)] max-md:[@media(max-height:740px)]:[--stage:clamp(400px,62svh,460px)] md:max-lg:[--stage:clamp(520px,60svh,640px)] lg:[--stage:clamp(560px,calc(100svh_-_92px),860px)] lg:data-[height=full]:[--stage:clamp(560px,calc(100svh_-_36px),1080px)]" id="{{ anchor }}" data-section="Hero Banner" data-height="{{ section.settings.height }}">
  <div class="hero relative z-0 grid grid-cols-[minmax(0,1fr)] [grid-template-areas:'stage'_'prod'] lg:mt-[calc(-1*(4.5rem+1px))] lg:[grid-template-areas:'stage']">
    <div class="img hero__media hp-hero-media img-bare relative h-[var(--stage)] text-ink-secondary [grid-area:stage] [&_.in]:bottom-auto [&_.in]:z-[2] [&_.in]:h-[46%] [&_.in]:gap-2 [&_.in]:p-4 md:max-lg:[&_.in]:left-[40%] lg:[&_.in]:bottom-0 lg:[&_.in]:left-1/2 lg:[&_.in]:h-auto [&_.lbl]:text-caption [&_.lbl]:font-semibold [&_.lbl]:uppercase [&_.lbl]:tracking-[0.18em] [&_.lbl]:text-ink [&_.dim]:text-caption [&_.dim]:text-ink-secondary">
      {%- if section.settings.image != blank -%}
        <picture class="absolute inset-0 z-[1]">
          {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 1080 }} 1080w, {{ section.settings.image_mobile | image_url: width: 720 }} 720w" sizes="100vw">{%- endif -%}
          {{ section.settings.image | image_url: width: 2880 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1080, 1440, 1920, 2880', sizes: '100vw', class: 'size-full object-cover', alt: section.settings.image.alt }}
        </picture>
      {%- else -%}
        <div class="in">
          <svg class="ph__ico size-[26px] max-w-full fill-none stroke-ink opacity-[.5] [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.25]" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="1"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
          <span class="lbl"><span class="ph__img">{{ 'sections.hero.placeholder_label' | t }}</span></span>
          <span class="dim ph__m md:hidden">{{ 'sections.hero.placeholder_mobile' | t }}</span>
          <span class="dim ph__t hidden md:max-lg:inline">{{ 'sections.hero.placeholder_tablet' | t }}</span>
          <span class="dim ph__d hidden lg:inline">{{ 'sections.hero.placeholder_desktop' | t }}</span>
        </div>
      {%- endif -%}
    </div>
    <div class="wrap hero__inner contents [grid-area:stage] lg:relative lg:z-[2] lg:flex lg:items-end lg:justify-between lg:gap-grid-gap lg:self-end lg:pb-16">
      <div class="hero__txt relative z-[2] px-gutter pb-6 [grid-area:stage] self-end group-data-[guides]:outline-offset-[12px] group-data-[guides]:[outline:1px_dashed_var(--color-brand-primary)] md:max-lg:max-w-[36rem] md:max-lg:pb-10 lg:max-w-[34rem] lg:p-0">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow type-overline mb-3 flex items-center gap-3 before:h-px before:w-8 before:flex-none before:bg-current before:content-[''] lg:mb-5"><span>{{ section.settings.eyebrow | escape }}</span></div>{%- endif -%}
        <h1 class="font-heading text-display font-medium leading-[1.04] tracking-display [text-wrap:balance]"><span>{{ section.settings.heading | replace: '<em>', '<em class="italic [font-weight:inherit] text-brand-secondary">' }}</span></h1>
        {%- if section.settings.text != blank -%}<p class="lead mt-3 max-w-[26rem] text-ink opacity-[.8] [text-wrap:pretty] max-md:[@media(max-height:740px)]:hidden lg:mt-5 lg:max-w-[28rem] lg:text-body-lg"><span>{{ section.settings.text | escape }}</span></p>{%- endif -%}
        <div class="mt-5 flex flex-row flex-wrap items-center gap-x-6 gap-y-1 lg:mt-8">
          {%- if section.settings.button_label != blank -%}{% render 'button-editorial', class: 'hero-btn hp-btn group min-h-12 gap-3', url: section.settings.button_link, label: section.settings.button_label, arrow: true %}{%- endif -%}
          {%- if section.settings.button_2_label != blank -%}{% render 'button-editorial', class: 'hero-btn hp-btn min-h-12 border-0 bg-transparent px-[2px] text-ink underline decoration-1 underline-offset-[6px] hover:bg-transparent hover:text-brand', url: section.settings.button_2_link, label: section.settings.button_2_label %}{%- endif -%}
        </div>
      </div>
      {%- if f_title != blank -%}
        <a class="hero__prod tagprod group flex min-h-touch items-center gap-4 mx-gutter border-b border-line py-3 text-ink no-underline [grid-area:prod] lg:m-0 lg:w-[300px] lg:flex-none lg:border lg:border-brand-accent lg:bg-page lg:py-3 lg:pl-3 lg:pr-5 lg:hover:border-ink" href="{{ f_url }}" aria-label="Featured in the campaign: {{ f_title | escape }}, {{ f_meta_spoken | escape }}. Shop now">
          <span class="img hero__pack img-bare w-12 flex-none aspect-[4/5] [background:color-mix(in_srgb,var(--color-bg-subtle)_78%,var(--color-bg-page))] lg:w-14 [&_.in]:p-[2px] [&_.lbl]:text-[10px] [&_.lbl]:tracking-normal [&_.lbl]:text-ink-muted [&_.dim]:sr-only" aria-hidden="true">
            {%- if prod != blank and prod.featured_image != blank -%}{{ prod.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'absolute inset-0 size-full object-cover', alt: '' }}{%- else -%}<span class="in"><span class="lbl">{{ 'sections.hero.packshot_label' | t }}</span><span class="dim">{{ 'sections.hero.packshot_dim' | t }}</span></span>{%- endif -%}
          </span>
          <span class="hero__pb flex min-w-0 flex-col leading-[1.3]"><span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-brand">{{ section.settings.featured_label | escape }}</span><span class="font-heading text-[18px] font-medium">{{ f_title | escape }}</span><span class="text-body-sm text-ink-secondary">{{ f_meta | escape }}</span></span>
          {% render 'icon', name: 'arrow-right', class: 'icon ml-auto size-4 text-brand transition-transform duration-base group-hover:translate-x-[3px]' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "shopify-section-hero",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Campaign image", "info": "Desktop 16:9, 2880 x 1620 px, subject in the right half." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. 2:3, 1080 x 1620 px, subject in the top half." },
    { "type": "select", "id": "height", "label": "Desktop height", "options": [ { "value": "large", "label": "Large (next section peeks)" }, { "value": "full", "label": "Full screen" } ], "default": "large" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The ritual edit · AW26" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Radiance, <em>Gently</em> Nudged.", "info": "Use italic for the emphasised word. This is the page's H1." },
    { "type": "text", "id": "text", "label": "Text", "default": "Skin care, makeup, hair and body, chosen to work together." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "Shop the edit" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button_2_label", "label": "Text link label", "default": "Find your routine" },
    { "type": "url", "id": "button_2_link", "label": "Text link" },
    { "type": "header", "content": "Featured product card" },
    { "type": "product", "id": "featured_product", "label": "Product", "info": "Leave empty to use the text below." },
    { "type": "text", "id": "featured_label", "label": "Label", "default": "Featured" },
    { "type": "text", "id": "featured_title", "label": "Title (when no product is chosen)", "default": "Face Serum" },
    { "type": "text", "id": "featured_meta", "label": "Details (when no product is chosen)", "default": "30 ml · $32.00" },
    { "type": "url", "id": "featured_url", "label": "Link (when no product is chosen)" },
    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s03", "info": "Lets other links jump here, for example #s03." }
  ],
  "presets": [ { "name": "Hero banner" } ]
}
{% endschema %}
{%- assign concerns = section.blocks | where: 'type', 'concern' -%}
{%- assign steps = section.blocks | where: 'type', 'routine_step' -%}
<section class="sec bg-surface text-ink" id="{{ section.settings.anchor | default: 's07' }}">
  <div class="sec__in py-section">
    <div class="wrap">
      {% render 'section-heading', title: section.settings.heading, lead: section.settings.lead %}
      {%- if concerns.size > 0 -%}
        <div class="grp__t mb-5 text-center text-caption font-semibold uppercase tracking-[0.14em] text-brand"><span>{{ section.settings.concern_title | escape }}</span></div>
        <div class="g--concern grid min-w-0 grid-cols-3 gap-x-2 gap-y-5 max-[374px]:gap-y-4 lg:grid-cols-6 lg:gap-grid-gap [&>*]:min-w-0">
          {%- for block in concerns -%}{% render 'concern-card', block: block %}{%- endfor -%}
        </div>
      {%- endif -%}
      {%- if steps.size > 0 -%}
        <div class="grp__t grp__t--2 mb-5 mt-9 text-center text-caption font-semibold uppercase tracking-[0.14em] text-brand sm:mt-12 lg:mt-16"><span>{{ section.settings.routine_title | escape }}</span></div>
        <ol class="rsteps m-0 flex list-none flex-wrap justify-center gap-3 p-0">
          {%- for block in steps -%}
            <li {{ block.shopify_attributes }}><a class="rstep inline-flex min-h-touch items-center gap-3 rounded-pill border border-line-inverse bg-surface py-2 pl-2 pr-5 text-body-sm font-medium text-ink no-underline transition-colors duration-base hover:border-brand hover:text-brand" href="{{ block.settings.link | default: block.settings.collection.url | default: '#' }}"><i class="n inline-flex size-[30px] flex-none items-center justify-center rounded-full border border-line-inverse bg-page font-heading text-body font-semibold not-italic leading-[1] text-ink">{{ forloop.index }}</i><span>{{ block.settings.label | escape }}</span></a></li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Concern and routine",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by concern or routine" },
    { "type": "text", "id": "lead", "label": "Text", "default": "Start with what you want to look after, or build a routine step by step." },
    { "type": "text", "id": "concern_title", "label": "Concern group title", "default": "By skin concern" },
    { "type": "text", "id": "routine_title", "label": "Routine group title", "default": "By routine step" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s07" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to use the collection link." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square, 400 x 400 px." },
        { "type": "select", "id": "tone", "label": "Placeholder tone", "options": [ { "value": "", "label": "None" }, { "value": "t2", "label": "Tint 2" }, { "value": "t3", "label": "Tint 3" }, { "value": "t4", "label": "Tint 4" } ], "default": "" }
      ]
    },
    {
      "type": "routine_step",
      "name": "Routine step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Cleanse" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to use the collection link." }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    { "name": "Concern and routine", "blocks": [ { "type": "concern" }, { "type": "concern" }, { "type": "concern" }, { "type": "concern" }, { "type": "concern" }, { "type": "concern" }, { "type": "routine_step", "settings": { "label": "Cleanse" } }, { "type": "routine_step", "settings": { "label": "Treat" } }, { "type": "routine_step", "settings": { "label": "Moisturise" } }, { "type": "routine_step", "settings": { "label": "Protect" } } ] }
  ]
}
{% endschema %}
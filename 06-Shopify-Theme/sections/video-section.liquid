{%- assign v = section.settings.video_url -%}
{%- assign embed = '' -%}
{%- if v.type == 'youtube' -%}{%- capture embed -%}https://www.youtube-nocookie.com/embed/{{ v.id }}?autoplay=1&rel=0{%- endcapture -%}
{%- elsif v.type == 'vimeo' -%}{%- capture embed -%}https://player.vimeo.com/video/{{ v.id }}?autoplay=1{%- endcapture -%}{%- endif -%}
<section class="sec bg-inverse text-ink-inverse" id="{{ section.settings.anchor | default: 's12' }}">
  <div class="sec__in py-section">
    <div class="wrap vid grid grid-cols-[minmax(0,1fr)] items-center gap-6 md:grid-cols-12 md:items-end md:gap-0">
      <div class="vid__box relative min-w-0 md:col-[1/span_9] md:row-[1]">
        <div class="img r169 t4 [&_.in]:justify-end [&_.in]:pb-3"><i class="ratio"></i>
          {%- if section.settings.cover_image != blank -%}
            {{ section.settings.cover_image | image_url: width: 1280 | image_tag: loading: 'lazy', widths: '640, 960, 1280', sizes: '(min-width: 768px) 70vw, 100vw', class: 'absolute inset-0 size-full object-cover', alt: section.settings.cover_image.alt }}
          {%- else -%}
            <div class="in"><span class="lbl">{{ 'sections.video.poster' | t }}</span><span class="dim">{{ 'sections.video.poster_dim' | t }}</span></div>
          {%- endif -%}
        </div>
        <button class="play absolute left-1/2 top-1/2 z-[5] -ml-[38px] -mt-[38px] flex size-[76px] cursor-pointer items-center justify-center rounded-full border-0 bg-[color-mix(in_srgb,var(--color-bg-page)_92%,transparent)] p-0 pl-1 text-[22px] text-ink transition-[transform,background-color] duration-base hover:scale-[1.06] hover:bg-surface" type="button" aria-label="{{ 'sections.video.play' | t }}"{% if embed != blank %} data-embed="{{ embed }}" data-title="{{ section.settings.heading | escape }}"{% endif %}>&#9654;</button>
        {%- if section.settings.duration != blank -%}<span class="dur absolute bottom-3 right-3 z-[5] bg-[color-mix(in_srgb,var(--color-bg-inverse)_75%,transparent)] px-2 py-1 text-caption font-medium text-ink-inverse">{{ section.settings.duration | escape }}</span>{%- endif -%}
      </div>
      <div class="vid__txt relative z-[2] -mt-8 bg-page px-5 pb-8 pt-7 text-ink md:col-[8/-1] md:row-[1] md:mb-10 md:mt-0 md:p-8 lg:mb-14 lg:p-[calc(var(--space-10)+var(--space-1))]">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow type-overline mb-3"><span>{{ section.settings.eyebrow | escape }}</span></div>{%- endif -%}
        <h2><span>{{ section.settings.heading | escape }}</span></h2>
        {%- if section.settings.text != blank -%}<p class="lead mt-3 max-w-[38rem] text-ink-secondary"><span>{{ section.settings.text | escape }}</span></p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}{% render 'button-editorial', class: 'hp-btn hp-btn-o mt-5', url: section.settings.button_link, label: section.settings.button_label %}{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Video", "info": "YouTube or Vimeo. The video loads when the shopper taps play." },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image", "info": "16:9, 1280 x 720 px." },
    { "type": "text", "id": "duration", "label": "Duration", "default": "2:00" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Tutorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch: building a simple routine" },
    { "type": "text", "id": "text", "label": "Text", "default": "A short tutorial that shows the steps in order." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s12" }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
{%- assign pins = section.blocks | where: 'type', 'pin' -%}
<section class="sec bg-page text-ink" id="{{ section.settings.anchor | default: 's09' }}">
  <div class="sec__in py-section">
    <div class="wrap look grid grid-cols-[minmax(0,1fr)] items-center gap-6 md:grid-cols-[7fr_5fr] md:gap-9 lg:grid-cols-[7fr_6fr] lg:gap-0">
      <div class="look__wrap relative mx-auto w-full min-w-0 max-w-[40rem] lg:ml-0">
        <div class="img look__img t4 [&_.in]:justify-end [&_.in]:pb-3">
          <i class="ratio pt-[100%] md:pt-[118%]"></i>
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 1024px) 50vw, 100vw', class: 'absolute inset-0 size-full object-cover', alt: section.settings.image.alt }}
          {%- else -%}
            <div class="in"><span class="lbl">{{ 'sections.look.photo' | t }}</span><span class="dim dim--s md:hidden">{{ 'sections.look.photo_dim_mobile' | t }}</span><span class="dim dim--l hidden md:inline">{{ 'sections.look.photo_dim_desktop' | t }}</span></div>
          {%- endif -%}
        </div>
        {%- for block in pins -%}{% render 'look-pin', block: block, number: forloop.index %}{%- endfor -%}
      </div>
      <div class="look__list relative z-[2] bg-surface px-5 py-6 shadow-lg md:p-8 lg:-ml-24 lg:p-10">
        <h2><span>{{ section.settings.heading | escape }}</span></h2>
        {%- if section.settings.text != blank -%}<p class="lead mb-3 mt-3 max-w-[38rem] text-ink-secondary"><span>{{ section.settings.text | escape }}</span></p>{%- endif -%}
        {%- for block in pins -%}
          {%- liquid
            assign tone = ''
            if forloop.index == 2
              assign tone = 't2'
            elsif forloop.index == 3
              assign tone = 't3'
            endif
          -%}
          {% render 'look-row', block: block, number: forloop.index, tone: tone %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Look photo", "info": "Portrait 5:6, 1200 x 1440 px (square, 1000 x 1000 px, on phones)." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "text", "id": "text", "label": "Text", "default": "Everyday makeup, with the products used." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s09" }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "Product pin",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position", "default": 50 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Shop the look", "blocks": [ { "type": "pin", "settings": { "x": 40, "y": 24 } }, { "type": "pin", "settings": { "x": 58, "y": 48 } }, { "type": "pin", "settings": { "x": 34, "y": 70 } } ] }
  ]
}
{% endschema %}
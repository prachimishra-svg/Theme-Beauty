{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- assign first_q = questions.first -%}
{%- assign first_opts = first_q.settings.options | newline_to_br | strip_newlines | split: '<br />' -%}
{%- assign back_label = 'sections.finder.back' | t -%}
{%- assign next_label = 'sections.finder.next' | t -%}
{%- assign result_url = section.settings.result_link | default: section.settings.result_collection.url -%}
<section class="sec bg-subtle text-ink" id="{{ section.settings.anchor | default: 's08' }}">
  <div class="sec__in py-section">
    <div class="wrap finder grid grid-cols-[minmax(0,1fr)] items-center gap-6 md:grid-cols-[5fr_6fr] md:gap-[calc(var(--space-14)+var(--space-1))] lg:gap-[calc(var(--space-20)+var(--space-2))]">
      <div class="finder__txt text-center md:text-left">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow type-overline mb-3"><span>{{ section.settings.eyebrow | escape }}</span></div>{%- endif -%}
        <h2><span>{{ section.settings.heading | escape }}</span></h2>
        {%- if section.settings.text != blank -%}<p class="lead mx-auto mt-3 max-w-[38rem] text-ink-secondary md:ml-0"><span>{{ section.settings.text | escape }}</span></p>{%- endif -%}
      </div>
      {%- if questions.size > 0 -%}
        <div class="finder__card relative border-0 bg-surface px-5 py-6 shadow-[10px_10px_0_var(--color-brand-accent)] md:p-10" id="finder">
          <div class="stepper mb-3 text-caption font-semibold uppercase tracking-[0.12em] text-brand" id="f-step">{{ 'sections.finder.step' | t: current: 1, total: questions.size }}</div>
          <b class="fq block font-heading text-[22px] font-medium leading-[1.2] sm:text-[24px] lg:text-[28px]" id="f-q">{{ first_q.settings.question | escape }}</b>
          <div class="chips my-5 flex flex-wrap gap-2" id="f-chips">
            {%- for opt in first_opts -%}{%- assign opt_label = opt | strip -%}{% render 'chip-editorial', label: opt_label, on: forloop.first %}{%- endfor -%}
          </div>
          <div class="mt-6 flex flex-row flex-wrap gap-3">{% render 'button-editorial', element: 'button', class: 'hp-btn hp-btn-o flex-[1_1_8rem]', id: 'f-back', label: back_label %}{% render 'button-editorial', element: 'button', class: 'hp-btn flex-[1_1_8rem]', id: 'f-next', label: next_label %}</div>
          <div class="result mt-4 flex flex-col gap-3 border-t border-line pt-4" id="f-res" hidden><b>{{ section.settings.result_text | escape }}</b>{% render 'button-editorial', class: 'hp-btn w-full', url: result_url, label: section.settings.result_button %}</div>
          <ul hidden data-finder-source data-result-step="{{ 'sections.finder.result' | t | escape }}" data-result-title="{{ 'sections.finder.matches' | t | escape }}">
            {%- for block in questions -%}<li data-question="{{ block.settings.question | escape }}" {{ block.shopify_attributes }}>{{ block.settings.options | escape }}</li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guided finder",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Guided finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Answer three quick questions and we will point you to a matching collection." },
    { "type": "header", "content": "Result" },
    { "type": "text", "id": "result_text", "label": "Result text", "default": "Your starting routine: Cleanse, Treat, Moisturise" },
    { "type": "text", "id": "result_button", "label": "Result button label", "default": "See matching products" },
    { "type": "collection", "id": "result_collection", "label": "Result collection" },
    { "type": "url", "id": "result_link", "label": "Result link", "info": "Leave empty to use the collection link." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s08" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your skin type?" },
        { "type": "textarea", "id": "options", "label": "Answers", "default": "Dry\nNormal\nOily", "info": "One answer per line." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Guided finder", "blocks": [ { "type": "question" } ] }
  ]
}
{% endschema %}
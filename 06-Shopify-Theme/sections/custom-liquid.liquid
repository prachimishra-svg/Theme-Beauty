{%- if section.settings.custom_liquid != blank -%}
<section class="sec bg-page text-ink" id="{{ section.settings.anchor | default: 's18' }}">
  <div class="sec__in sec__in--tight py-[calc(var(--space-section)/2)]">
    <div class="wrap">
      {{ section.settings.custom_liquid }}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="sec bg-page text-ink" id="{{ section.settings.anchor | default: 's18' }}">
  <div class="sec__in sec__in--tight py-[calc(var(--space-section)/2)]">
    <div class="wrap">
      <div class="flex flex-col items-center gap-1 border border-dashed border-line-inverse px-gutter py-5 text-center text-body-sm text-ink-secondary"><b class="font-semibold text-ink">{{ 'sections.custom_liquid.title' | t }}</b><span>{{ 'sections.custom_liquid.empty' | t }}</span></div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Optional and empty by default. Nothing is shown to shoppers until you add code. Add app blocks or custom code here." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s18" }
  ],
  "presets": [ { "name": "Custom Liquid" } ]
}
{% endschema %}
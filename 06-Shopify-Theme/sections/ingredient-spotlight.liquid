{%- assign free_items = section.settings.free_from | newline_to_br | strip_newlines | split: '<br />' -%}
<section class="sec bg-surface text-ink" id="{{ section.settings.anchor | default: 's10' }}">
  <div class="sec__in py-section">
    <div class="wrap">
      {% render 'section-heading', title: section.settings.heading, lead: section.settings.lead %}
      <div class="g--ing grid min-w-0 grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-grid-gap [&>*]:min-w-0">
        {%- for block in section.blocks -%}{% render 'ingredient-card', block: block, number: forloop.index %}{%- endfor -%}
      </div>
      {%- if free_items.size > 0 and section.settings.free_from != blank -%}
        <div class="free mt-8 flex flex-wrap items-center justify-center gap-2 sm:mt-[calc(var(--space-10)+var(--space-1))] lg:mt-14"><b class="mr-1 font-semibold"><span>{{ section.settings.free_from_label | escape }}</span></b>
          {%- for item in free_items -%}{%- assign item_label = item | strip -%}{% render 'chip-tag', label: item_label %}{%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.source_line != blank -%}<div class="src-line mt-4 text-center text-body-sm text-ink-muted"><span>{{ section.settings.source_line | escape }}</span></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient spotlight",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What is inside" },
    { "type": "text", "id": "lead", "label": "Text", "default": "Key ingredients and where they come from." },
    { "type": "text", "id": "free_from_label", "label": "Free-from label", "default": "Free from:" },
    { "type": "textarea", "id": "free_from", "label": "Free from", "default": "Item 1\nItem 2\nItem 3\nItem 4", "info": "One item per line." },
    { "type": "text", "id": "source_line", "label": "Source line", "default": "Source line: where the key ingredients come from (merchant to provide)." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s10" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square macro photo, 600 x 600 px." },
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient name" },
        { "type": "text", "id": "text", "label": "Description", "default": "One line on what it is and why it is used. Merchant to provide; no claims without evidence." },
        { "type": "select", "id": "tone", "label": "Placeholder tone", "options": [ { "value": "", "label": "None" }, { "value": "t2", "label": "Tint 2" }, { "value": "t3", "label": "Tint 3" }, { "value": "t4", "label": "Tint 4" } ], "default": "" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Ingredient spotlight", "blocks": [ { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" } ] }
  ]
}
{% endschema %}
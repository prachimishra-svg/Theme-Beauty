<section class="sec bg-page text-ink" id="{{ section.settings.anchor | default: 's15' }}">
  <div class="sec__in py-section">
    <div class="wrap">
      {% render 'section-heading', title: section.settings.heading, lead: section.settings.lead %}
      <div class="g--gal grid min-w-0 grid-cols-2 gap-2 md:grid-cols-4 md:gap-3 lg:gap-4 [&>*]:min-w-0">
        {%- for block in section.blocks -%}{% render 'gallery-tile', block: block, number: forloop.index %}{%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer photo gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer photos" },
    { "type": "text", "id": "lead", "label": "Text", "default": "Photos from customers, uploaded by the merchant." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s15" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "At least 800 px on the short side." },
        { "type": "select", "id": "size", "label": "Size in the mosaic", "options": [ { "value": "normal", "label": "Normal" }, { "value": "large", "label": "Large (2 x 2 on desktop)" }, { "value": "wide", "label": "Wide (full row on desktop)" } ], "default": "normal" },
        { "type": "select", "id": "tone", "label": "Placeholder tone", "options": [ { "value": "", "label": "None" }, { "value": "t2", "label": "Tint 2" }, { "value": "t3", "label": "Tint 3" }, { "value": "t4", "label": "Tint 4" } ], "default": "" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Customer photo gallery", "blocks": [ { "type": "photo", "settings": { "size": "large" } }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo", "settings": { "size": "wide" } } ] } ]
}
{% endschema %}
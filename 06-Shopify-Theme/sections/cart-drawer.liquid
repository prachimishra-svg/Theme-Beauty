{%- liquid
  assign threshold = section.settings.free_shipping_threshold
  assign threshold_cents = threshold | times: 100
  assign subtotal = cart.items_subtotal_price
  assign is_empty = false
  if cart.item_count == 0
    assign is_empty = true
  endif
  assign total_save = 0
  for item in cart.items
    assign line_save = item.original_line_price | minus: item.final_line_price
    assign total_save = total_save | plus: line_save
  endfor
  assign cart_aria = 'general.cart_aria' | t: count: cart.item_count
  assign items_label = 'cart.items_count' | t: count: cart.item_count
  assign close_label = 'cart.close' | t
  assign subtotal_money = subtotal | money
  assign save_money = total_save | money
  assign cart_pids = cart.items | map: 'product_id'
  assign shown_upsell = false
  assign tone_index = 0
-%}
<dialog class="drawer leading-normal" id="cart-drawer" aria-labelledby="cd-title" data-cart-count="{{ cart.item_count }}" data-cart-aria="{{ cart_aria | escape }}" data-msg-stock="{{ 'cart.qty_stock' | t: count: '__N__' | escape }}" data-msg-limit="{{ 'cart.qty_limit' | t | escape }}" data-msg-removed="{{ 'cart.removed' | t: title: '__TITLE__' | escape }}" data-checkout-url="{{ routes.root_url }}checkout">
  <div class="drawer-head">
    <h2 class="type-h5 m-0" id="cd-title">{{ 'general.cart' | t }} <span class="font-body text-body-sm font-regular normal-case tracking-normal text-ink-secondary" id="cd-count">{{ items_label }}</span></h2>
    <button class="icon-btn" type="button" data-drawer-close aria-label="{{ close_label }}">{% render 'icon', name: 'close', class: 'icon size-5' %}</button>
  </div>
  <div class="drawer-body flex flex-col gap-4" id="cd-body">
    <div id="cd-cart" class="flex flex-col gap-4"{% if is_empty %} hidden{% endif %}>
      <div id="cd-fs">
        {%- if threshold > 0 -%}
          {%- liquid
            assign remaining = threshold_cents | minus: subtotal
            assign pct = subtotal | times: 100 | divided_by: threshold_cents
            if pct > 100
              assign pct = 100
            endif
            assign done = false
            if remaining <= 0
              assign done = true
              assign remaining = 0
            endif
            assign remaining_money = remaining | money
            assign now_units = subtotal | divided_by: 100
            if now_units > threshold
              assign now_units = threshold
            endif
          -%}
          <div class="fs group flex flex-col gap-2" data-done="{{ done }}"><p class="fs__t text-body-sm" role="status">{%- if done -%}{{ 'cart.free_shipping_reached_html' | t }}{%- else -%}{{ 'cart.free_shipping_away_html' | t: amount: remaining_money }}{%- endif -%}</p><div class="fs__bar relative h-1 overflow-hidden bg-line" role="progressbar" aria-label="{{ 'cart.free_shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="{{ threshold }}" aria-valuenow="{{ now_units }}" style="--p:{{ pct }}%"><span class="absolute inset-y-0 left-0 w-[var(--p)] bg-brand transition-[width] duration-slow group-data-[done=true]:bg-status-success"></span></div></div>
        {%- endif -%}
      </div>
      <div id="cd-undo"></div>
      <div id="cd-lines"><ul class="m-0 list-none p-0">{%- for item in cart.items -%}{%- assign tone_index = item.product_id | modulo: 3 -%}{% render 'cart-line', item: item, tone_index: tone_index %}{%- endfor -%}</ul></div>
      <div id="cd-up">
        {%- for product in section.settings.upsell_collection.products limit: 8 -%}
          {%- unless shown_upsell or cart_pids contains product.id -%}
            {%- assign shown_upsell = true -%}
            {%- assign uv = product.selected_or_first_available_variant -%}
            {%- assign uvt = uv.title -%}
            {%- if uvt == 'Default Title' -%}{%- assign uvt = '' -%}{%- endif -%}
            {%- assign up_price = uv.price | money -%}
            {%- assign add_aria = 'cart.add_to_cart' | t: title: product.title -%}
            <div class="flex flex-col gap-3"><h2 class="type-h5">{{ section.settings.upsell_heading | escape }}</h2><ul class="m-0 list-none p-0"><li class="up__row grid grid-cols-[var(--space-14)_minmax(0,1fr)_auto] items-center gap-4 border-t border-line py-3"><div class="relative aspect-portrait overflow-hidden" aria-hidden="true">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'absolute inset-0 size-full object-cover', alt: '' }}{%- else -%}<div class="ph absolute inset-0"></div>{%- endif -%}</div><div><span class="up__name block font-heading text-body-lg leading-snug">{{ product.title | escape }}</span><span class="text-body-sm text-ink-secondary">{% if uvt != blank %}{{ uvt | escape }} &middot; {% endif %}{{ up_price }}</span></div><button class="btn btn-secondary" type="button" data-add="{{ uv.id }}" aria-label="{{ add_aria | escape }}">{{ 'cart.add' | t }}</button></li></ul></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
    <div id="cd-empty" class="flex flex-1 flex-col items-center justify-center gap-5 py-10 text-center"{% unless is_empty %} hidden{% endunless %}>
      <p class="type-h4 m-0">{{ 'cart.empty_title' | t }}</p>
      <p class="m-0 text-ink-secondary">{{ 'cart.empty_text' | t }}</p>
      <button class="btn btn-primary" type="button" data-drawer-close id="cd-continue">{{ 'cart.continue_shopping' | t }}</button>
      {%- if section.settings.empty_menu.links.size > 0 -%}
        <div class="chip-row justify-center" aria-label="{{ 'cart.shop_by_collection' | t }}">{%- for link in section.settings.empty_menu.links -%}<a class="chip" href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}</div>
      {%- endif -%}
    </div>
  </div>
  <div class="drawer-foot flex flex-col gap-3" id="cd-foot"{% if is_empty %} hidden{% endif %}>
    <div class="flex items-baseline justify-between gap-4"><span>{{ 'cart.subtotal' | t }}</span><span class="font-heading text-h4 font-regular leading-tight [font-variant-numeric:lining-nums]" id="cd-sub">{{ subtotal_money }}</span></div>
    <div class="flex items-baseline justify-between gap-4 text-brand" id="cd-savrow"{% if total_save <= 0 %} hidden{% endif %}><span>{{ 'cart.you_save' | t }}</span><span id="cd-sav">{{ save_money }}</span></div>
    <p class="m-0 text-caption text-ink-secondary">{{ 'cart.taxes_note' | t }}</p>
    <button class="btn btn-primary btn-lg btn-block" type="button" id="cd-checkout" data-checkout>{% render 'icon', name: 'lock', class: 'icon size-5' %}<span>{{ 'cart.checkout' | t }}</span></button>
    <a class="link link-standalone justify-center" href="{{ routes.cart_url }}" id="cd-viewcart">{{ 'cart.view_cart' | t }}</a>
  </div>
  <template id="cd-undo-template"><p class="message message-success mb-4 items-center" role="status"><span data-undo-text></span><button class="link ml-auto min-h-touch" type="button" data-undo>{{ 'cart.undo' | t }}</button></p></template>
  <template id="cd-error-template"><p class="cl__err text-caption text-status-error" role="alert"></p></template>
</dialog>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "paragraph", "content": "Shown when Theme settings > Cart > Cart type is Cart drawer. It reads Shopify's real cart and updates through the AJAX Cart API." },
    { "type": "number", "id": "free_shipping_threshold", "label": "Free shipping threshold", "default": 50, "info": "In the store's currency, whole units. Enter 0 to hide the progress bar. This only shows a message: shipping rates are set in Shopify." },
    { "type": "text", "id": "upsell_heading", "label": "Add-on heading", "default": "Add to your order" },
    { "type": "collection", "id": "upsell_collection", "label": "Add-on collection", "info": "The first product that is not already in the cart is offered." },
    { "type": "link_list", "id": "empty_menu", "label": "Empty cart links", "default": "cart-empty", "info": "Shown as chips when the cart is empty." }
  ]
}
{% endschema %}
{%- assign start = section.settings.start | default: 50 -%}
<section class="sec sec--ba bg-page text-ink" id="{{ section.settings.anchor | default: 's13' }}">
  <div class="cmp group relative w-full [--pos:50%]" data-start="{{ start }}">
    <div class="cmp__frame group/f relative aspect-square w-full cursor-ew-resize touch-pan-y select-none overflow-hidden bg-subtle sm:aspect-wide lg:aspect-[21/9] lg:max-h-[76svh] lg:min-h-[360px]">
      <div class="img cmp__img cmp__img--before absolute inset-0 h-full w-full [background:color-mix(in_srgb,var(--color-text-primary)_12%,var(--color-bg-surface))] before:hidden">
        {%- if section.settings.before_image != blank -%}{{ section.settings.before_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw', class: 'absolute inset-0 size-full object-cover', alt: section.settings.before_image.alt | default: section.settings.before_label }}{%- else -%}<div class="in sr-only"><span class="lbl">{{ 'sections.before_after.before_image' | t }}</span><span class="dim">{{ 'sections.before_after.before_dim' | t }}</span></div>{%- endif -%}
        <span class="cmp__tag cmp__tag--b pointer-events-none absolute bottom-4 left-4 z-[2] bg-[color-mix(in_srgb,var(--color-bg-surface)_86%,transparent)] px-3 py-2 text-caption font-semibold uppercase leading-[1.2] tracking-widest text-ink transition-opacity duration-base group-[.hide-b]:opacity-0 lg:bottom-6 lg:left-6 lg:px-4">{{ section.settings.before_label | escape }}</span>
      </div>
      <div class="img cmp__img cmp__img--after absolute inset-0 h-full w-full [background:var(--color-brand-tint)_repeating-linear-gradient(135deg,color-mix(in_srgb,var(--color-brand-primary)_7%,transparent)_0_1px,transparent_1px_10px)] [clip-path:inset(0_0_0_var(--pos))] before:hidden">
        {%- if section.settings.after_image != blank -%}{{ section.settings.after_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw', class: 'absolute inset-0 size-full object-cover', alt: section.settings.after_image.alt | default: section.settings.after_label }}{%- else -%}<div class="in sr-only"><span class="lbl">{{ 'sections.before_after.after_image' | t }}</span><span class="dim">{{ 'sections.before_after.after_dim' | t }}</span></div>{%- endif -%}
        <span class="cmp__tag cmp__tag--a pointer-events-none absolute bottom-4 right-4 z-[2] bg-[color-mix(in_srgb,var(--color-bg-surface)_86%,transparent)] px-3 py-2 text-caption font-semibold uppercase leading-[1.2] tracking-widest text-ink transition-opacity duration-base group-[.hide-a]:opacity-0 lg:bottom-6 lg:right-6 lg:px-4">{{ section.settings.after_label | escape }}</span>
      </div>
      <input class="cmp__range peer sr-only opacity-0" type="range" min="0" max="100" step="1" value="{{ start }}" aria-label="{{ 'sections.before_after.slider_label' | t }}">
      <div class="cmp__line pointer-events-none absolute inset-y-0 left-[var(--pos)] z-[3] -ml-px w-[2px] bg-surface" aria-hidden="true"><span class="cmp__handle absolute left-1/2 top-1/2 -ml-6 -mt-6 flex size-12 items-center justify-center gap-[2px] rounded-full border border-[color-mix(in_srgb,var(--color-text-primary)_18%,transparent)] bg-surface text-ink transition-transform duration-base group-hover/f:scale-[1.06] group-[.is-drag]/f:scale-[1.06] [.cmp__range:focus-visible~.cmp__line_&]:outline-offset-4 [.cmp__range:focus-visible~.cmp__line_&]:[outline:var(--focus-ring)] lg:-ml-7 lg:-mt-7 lg:size-14">{% render 'icon', name: 'chevron-left', class: 'icon size-4' %}{% render 'icon', name: 'chevron-right', class: 'icon size-4' %}</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before and after",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "Same size and crop as the After image." },
    { "type": "image_picker", "id": "after_image", "label": "After image", "info": "Same size and crop as the Before image." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "range", "id": "start", "min": 10, "max": 90, "step": 5, "unit": "%", "label": "Starting position", "default": 50 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "s13" }
  ],
  "presets": [ { "name": "Before and after" } ]
}
{% endschema %}
{%- assign b = block.settings -%}<div class="icard flex min-w-0 flex-col items-center gap-[2px] text-center" {{ block.shopify_attributes }}><div class="img circle{% if b.tone != blank %} {{ b.tone }}{% endif %} img-nodim mb-4 w-[78%] shadow-[0_0_0_6px_var(--color-bg-page),0_0_0_7px_var(--color-border-inverse)]"><i class="ratio"></i>{%- if b.image != blank -%}{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 768px) 20vw, 40vw', class: 'absolute inset-0 size-full object-cover', alt: b.image.alt | default: b.name }}{%- else -%}<div class="in"><span class="lbl">{{ 'sections.ingredient.photo' | t: number: number }}</span><span class="dim">{{ 'sections.ingredient.photo_dim' | t }}</span></div>{%- endif -%}</div><b class="tt type-h4 [font-variant-numeric:lining-nums] mb-1 block"><span>{{ b.name | escape }}</span></b>{%- if b.text != blank -%}<span class="sub mt-[2px] block text-body-sm text-ink-secondary"><span>{{ b.text | escape }}</span></span>{%- endif -%}</div>
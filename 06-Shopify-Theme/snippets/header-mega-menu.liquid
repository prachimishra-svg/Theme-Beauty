{%- assign shop_all_title = link.title | downcase -%}
{%- capture cards_html -%}{%- for block in blocks -%}{%- assign bkey = block.settings.menu_item | handleize -%}{%- if bkey == key -%}{% render 'header-mega-card', block: block, link: link %}{%- endif -%}{%- endfor -%}{%- endcapture -%}
<div id="mega-{{ key }}" data-mega-panel class="mega-panel hidden data-[open]:block lg:absolute lg:inset-x-0 lg:top-full lg:z-[1] lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:border-b lg:border-line lg:bg-page lg:shadow-md"><div class="mx-auto flex w-full max-w-[calc(var(--container-max)+2*var(--layout-gutter))] flex-col pb-3 pl-3 lg:px-gutter lg:py-8 lg:pl-gutter"><a href="{{ link.url }}" class="flex min-h-touch items-center gap-2 text-body font-medium text-brand no-underline hover:underline lg:order-last lg:mt-4 lg:self-start lg:border-t-0 lg:text-body-sm">{{ 'header.shop_all' | t: title: shop_all_title | escape }}{% render 'icon', name: 'arrow-right', class: 'icon size-5' %}</a><div class="lg:grid lg:grid-cols-[repeat(2,minmax(0,1fr))_minmax(0,1.2fr)] lg:gap-grid-gap">{%- for column in link.links -%}{% render 'header-mega-column', column: column %}{%- endfor -%}{%- if cards_html != blank -%}<div class="hidden grid-cols-2 gap-4 lg:grid">{{ cards_html }}</div>{%- endif -%}</div></div></div>
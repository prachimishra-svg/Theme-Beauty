<button class="tab{% if first %} on{% endif %} relative inline-flex min-h-touch cursor-pointer items-center border-0 border-b border-transparent bg-transparent px-5 text-body text-ink-secondary hover:text-ink aria-selected:border-brand aria-selected:text-ink" type="button" role="tab" aria-selected="{% if first %}true{% else %}false{% endif %}" data-set="{{ index0 }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span></button>
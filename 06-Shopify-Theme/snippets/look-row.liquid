{%- assign p = block.settings.product -%}<div class="lrow flex items-center gap-4 border-t border-line py-4"><i class="n inline-flex size-[30px] flex-none items-center justify-center rounded-full border border-line-inverse bg-page font-heading text-body font-semibold not-italic leading-[1] text-ink">{{ number }}</i><div class="img r11 thumb{% if tone != blank %} {{ tone }}{% endif %} img-nodim w-14 flex-none sm:w-16 lg:w-[calc(var(--space-16)+var(--space-2))] [&_.lbl]:hidden"><i class="ratio"></i>{%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'absolute inset-0 size-full object-cover', alt: p.title }}{%- else -%}<div class="in"><span class="lbl">{{ 'sections.look.thumb' | t }}</span><span class="dim">{{ 'sections.look.thumb_dim' | t }}</span></div>{%- endif -%}</div><div class="lrow__t min-w-0 flex-1"><b class="font-medium"><span>{{ p.title | escape }}</span></b><span class="pprice mt-[2px] block text-price font-medium"><span>{{ p.price | money }}</span></span></div><a class="hp-btn hp-btn-o hp-btn-s" href="{{ p.url | default: '#' }}">{{ 'sections.look.view' | t }}</a></div>
<div class="{{ hook }}__nav flex{% if end %} justify-end{% endif %} gap-2 [grid-area:nav] group-[.is-static]:invisible"><button class="{{ hook }}__prev inline-flex size-touch cursor-pointer items-center justify-center rounded-full border border-line-inverse bg-transparent p-0 text-ink transition-colors duration-base enabled:hover:border-ink disabled:cursor-default disabled:opacity-[.35]" type="button" aria-label="{{ prev }}">{% render 'icon', name: 'arrow-left', class: 'icon size-[18px]' %}</button><button class="{{ hook }}__next inline-flex size-touch cursor-pointer items-center justify-center rounded-full border border-line-inverse bg-transparent p-0 text-ink transition-colors duration-base enabled:hover:border-ink disabled:cursor-default disabled:opacity-[.35]" type="button" aria-label="{{ next }}">{% render 'icon', name: 'arrow-right', class: 'icon size-[18px]' %}</button></div>
<a href="{{ block.settings.link | default: link.url }}" class="group/card block min-w-0 no-underline" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<div class="relative aspect-portrait overflow-hidden rounded-card border border-line">{{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 20vw, 0px', widths: '320, 480, 640', class: 'absolute inset-0 size-full object-cover', alt: block.settings.image.alt | default: block.settings.title }}</div>{%- else -%}<div class="{{ block.settings.tone }} relative flex aspect-portrait items-start justify-start overflow-hidden rounded-card border border-line p-2 text-caption leading-snug text-ink-muted"><span>{{ 'general.placeholder_image' | t }}<br>4:5</span></div>{%- endif -%}<p class="mt-3 text-body-sm font-medium text-ink group-hover/card:underline">{{ block.settings.title | escape }}</p><p class="flex items-center gap-1 text-caption text-ink-muted">{%- if block.settings.cta != blank -%}{{ block.settings.cta | escape }}{%- else -%}{{ 'header.shop_now' | t }}{%- endif -%}{% render 'icon', name: 'arrow-right', class: 'icon size-4' %}</p></a>
<div class="fcol group border-t border-line-inverse-subtle md:border-t-0" {{ block.shopify_attributes }}><button type="button" aria-expanded="false" class="flex min-h-12 w-full items-center justify-between text-left type-h6 text-ink-inverse md:pointer-events-none md:mb-3 md:min-h-0"><span>{{ block.settings.heading | escape }}</span>{% render 'icon', name: 'plus', class: 'icon size-6 md:hidden' %}</button><div class="hidden flex-col pb-2 group-[.is-open]:flex md:flex md:pb-0">{%- for link in block.settings.menu.links -%}<a href="{{ link.url }}" class="flex min-h-touch items-center text-ink-inverse-secondary no-underline hover:text-ink-inverse hover:underline">{{ link.title | escape }}</a>{%- endfor -%}</div></div>
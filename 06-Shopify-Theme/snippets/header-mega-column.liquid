<div class="mb-2 lg:mb-0"><p class="pb-1 pt-3 text-overline font-medium uppercase tracking-uppercase text-ink-muted lg:pb-3 lg:pt-0">{{ column.title | escape }}</p><ul class="m-0 list-none p-0">{%- for item in column.links -%}<li><a href="{{ item.url }}" class="flex min-h-touch items-center text-body text-ink no-underline hover:text-brand hover:underline lg:min-h-0 lg:py-2"{% if item.current %} aria-current="page"{% endif %}>{{ item.title | escape }}</a></li>{%- endfor -%}</ul></div>
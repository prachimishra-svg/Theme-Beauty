{%- assign b = block.settings -%}{%- assign title = b.title | default: b.collection.title -%}<a class="tile group block text-center text-ink no-underline" href="{{ b.link | default: b.collection.url | default: '#' }}" {{ block.shopify_attributes }}><div class="img circle{% if b.tone != blank %} {{ b.tone }}{% endif %} img-nodim transition-shadow duration-base group-hover:shadow-[0_0_0_3px_var(--color-bg-page),0_0_0_4px_var(--color-brand-primary)]"><i class="ratio"></i>{%- if b.image != blank -%}{{ b.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 1024px) 15vw, 30vw', class: 'absolute inset-0 size-full object-cover', alt: b.image.alt | default: title }}{%- else -%}<div class="in"><span class="lbl">{{ 'sections.concern.photo' | t: title: title }}</span><span class="dim">{{ 'sections.concern.photo_dim' | t }}</span></div>{%- endif -%}</div><b class="mt-3 block text-body-sm font-medium"><span>{{ title | escape }}</span></b></a>
{%- assign b = block.settings -%}
{%- assign title = b.title | default: b.collection.title -%}
{%- assign url = b.link | default: b.collection.url | default: '#' -%}
{%- case b.layout -%}
  {%- when 'tall' -%}
    {%- assign tile_class = 'tile group relative col-span-2 block overflow-hidden text-ink no-underline md:col-[1] md:row-[1/span_2]' -%}
    {%- assign img_class = 'img t2 transition-transform [transition:transform_.5s_var(--ease-standard)] group-hover:scale-[1.03] md:absolute md:inset-0 md:h-full' -%}
    {%- assign ratio_class = 'ratio pt-[62%] md:hidden' -%}
    {%- assign dim = 'Tall editorial crop, 900 x 1300 (1.25 : 1 wide on mobile)' -%}
  {%- when 'top_middle' -%}
    {%- assign tile_class = 'tile group relative block overflow-hidden text-ink no-underline md:col-[2] md:row-[1]' -%}
    {%- assign img_class = 'img t3 [transition:transform_.5s_var(--ease-standard)] group-hover:scale-[1.03] md:absolute md:inset-0 md:h-full' -%}
    {%- assign ratio_class = 'ratio md:hidden' -%}
    {%- assign dim = '4:5, 800 x 1000' -%}
  {%- when 'top_right' -%}
    {%- assign tile_class = 'tile group relative block overflow-hidden text-ink no-underline md:col-[3] md:row-[1]' -%}
    {%- assign img_class = 'img t4 [transition:transform_.5s_var(--ease-standard)] group-hover:scale-[1.03] md:absolute md:inset-0 md:h-full' -%}
    {%- assign ratio_class = 'ratio md:hidden' -%}
    {%- assign dim = '4:5, 800 x 1000' -%}
  {%- when 'wide' -%}
    {%- assign tile_class = 'tile group relative col-span-2 block overflow-hidden text-ink no-underline md:col-[2/span_2] md:row-[2]' -%}
    {%- assign img_class = 'img [transition:transform_.5s_var(--ease-standard)] group-hover:scale-[1.03] md:absolute md:inset-0 md:h-full' -%}
    {%- assign ratio_class = 'ratio pt-[62%] md:hidden' -%}
    {%- assign dim = 'Wide crop, 1400 x 640' -%}
{%- endcase -%}
<a class="{{ tile_class }}" href="{{ url }}" {{ block.shopify_attributes }}><div class="{{ img_class }}"><i class="{{ ratio_class }}"></i>{%- if b.image != blank -%}{{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 768px) 40vw, 100vw', class: 'absolute inset-0 size-full object-cover', alt: b.image.alt | default: title }}{%- else -%}<div class="in"><span class="lbl">{{ 'sections.category.photo' | t: title: title }}</span><span class="dim">{{ dim }}</span></div>{%- endif -%}</div><span class="tile__cap block pt-4 md:absolute md:bottom-0 md:left-0 md:z-[3] md:max-w-[calc(100%-28px)] md:bg-page md:px-5 md:pb-2 md:pt-4"><b class="tt type-h4 [font-variant-numeric:lining-nums] block"><span>{{ title | escape }}</span></b>{%- if b.subtitle != blank -%}<span class="sub mt-1 block text-body-sm text-ink-secondary"><span>{{ b.subtitle | escape }}</span></span>{%- endif -%}<span class="lnk group-hover:gap-3 group-hover:text-brand"><span>{{ b.link_text | escape }}</span> {% render 'icon', name: 'arrow-right', class: 'icon' %}</span></span></a>
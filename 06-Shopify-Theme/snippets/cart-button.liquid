{%- assign aria = 'general.cart_aria' | t: count: cart.item_count -%}
{%- if type == 'drawer' -%}<button type="button" data-drawer-open="cart-drawer" aria-haspopup="dialog" aria-label="{{ aria }}" class="relative inline-flex min-h-touch min-w-touch items-center justify-center gap-2 whitespace-nowrap px-2 text-ink">{% render 'icon', name: 'bag', class: 'icon size-6' %}<span class="hidden lg:inline">{{ 'general.cart' | t }}</span><b class="cnt h-[18px] min-w-[18px] rounded-pill bg-brand px-1 text-center text-caption leading-[20px] text-ink-on-brand" data-cart-count>{{ cart.item_count }}</b></button>{%- elsif type == 'page' -%}<a href="{{ routes.cart_url }}" aria-label="{{ aria }}" aria-current="page" class="relative inline-flex min-h-touch min-w-touch items-center justify-center gap-2 whitespace-nowrap px-2 text-ink no-underline">{% render 'icon', name: 'bag', class: 'icon size-6' %}<span class="hidden lg:inline">{{ 'general.cart' | t }}</span><b class="cnt h-[18px] min-w-[18px] rounded-pill bg-brand px-1 text-center text-caption leading-[20px] text-ink-on-brand" data-cart-count>{{ cart.item_count }}</b></a>{%- else -%}<a href="{{ routes.cart_url }}" aria-label="{{ aria }}" class="relative inline-flex min-h-touch min-w-touch items-center justify-center gap-2 whitespace-nowrap px-2 text-ink no-underline">{% render 'icon', name: 'bag', class: 'icon size-6' %}<span class="hidden lg:inline">{{ 'general.cart' | t }}</span><b class="cnt h-[18px] min-w-[18px] rounded-pill bg-brand px-1 text-center text-caption leading-[20px] text-ink-on-brand" data-cart-count>{{ cart.item_count }}</b></a>{%- endif -%}
{%- if settings.show_localization and localization.available_countries.size > 1 -%}
<div class="relative self-start" id="market"><button type="button" id="market-btn" aria-haspopup="true" aria-expanded="false" aria-controls="market-menu" class="group inline-flex min-h-touch items-center gap-2 whitespace-nowrap rounded-pill border border-line-strong bg-transparent px-4 text-body-sm text-ink lg:px-3 xl:px-4">{% render 'icon', name: 'location', class: 'icon size-[18px]' %}<span id="market-label">{{ localization.country.name }} ({{ localization.country.currency.iso_code }})</span>{% render 'icon', name: 'chevron-down', class: 'icon size-4 transition-transform duration-fast group-aria-[expanded=true]:rotate-180' %}</button><div id="market-menu" role="group" aria-label="{{ 'header.country_selector' | t }}" hidden class="mt-2 w-full min-w-[260px] rounded-control border border-line-strong bg-surface p-2 shadow-md lg:absolute lg:left-0 lg:top-full lg:z-[60] lg:mt-1 lg:w-auto">
{%- form 'localization', id: 'localization-form', class: 'contents' -%}
<input type="hidden" name="return_to" value="{{ request.path }}"><input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-country-input>
{%- for country in localization.available_countries -%}{%- assign on = false -%}{%- if country.iso_code == localization.country.iso_code -%}{%- assign on = true -%}{%- endif -%}<button type="button" class="flex min-h-touch w-full items-center justify-between gap-6 rounded-control px-3 text-left text-body-sm text-ink hover:bg-subtle{% if on %} font-medium{% endif %}" data-market="{{ country.iso_code }}"{% if on %} aria-current="true"{% endif %}><span>{{ country.name }} <span class="font-regular text-ink-secondary">({{ country.currency.iso_code }} {{ country.currency.symbol }})</span></span>{% if on %}{% render 'icon', name: 'check', class: 'icon size-5 text-brand' %}{% endif %}</button>{%- endfor -%}
{%- endform -%}
</div></div>
{%- endif -%}
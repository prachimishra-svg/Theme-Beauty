<li {{ block.shopify_attributes }}><figure class="quote relative flex h-full flex-col gap-[2px] bg-page px-5 py-6 before:block before:h-7 before:font-heading before:text-[4rem] before:leading-[0.7] before:text-brand-secondary before:content-['“'] md:p-7"><div class="stars mb-3 flex gap-1 text-brand-secondary" aria-hidden="true">{%- for i in (1..5) -%}{%- if i <= rating -%}{% render 'icon', name: 'star', class: 'icon size-[14px] fill-current' %}{%- else -%}{% render 'icon', name: 'star', class: 'icon size-[14px] fill-current opacity-muted' %}{%- endif -%}{%- endfor -%}</div><blockquote class="flex-1 text-body-lg leading-relaxed"><span>{{ block.settings.quote | escape }}</span></blockquote><figcaption class="mt-4 text-body-sm font-semibold"><span>{{ block.settings.name | escape }}</span></figcaption>{%- if block.settings.product_label != blank -%}<a class="lnk" href="{{ block.settings.product_link | default: '#' }}"><span>{{ block.settings.product_label | escape }}</span> {% render 'icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}</figure></li>
{%- assign b = block.settings -%}<li {{ block.shopify_attributes }}><a class="rec__item logo-i group flex min-h-touch flex-col items-center gap-2 px-2 py-1 no-underline" href="{{ b.link | default: '#' }}" aria-label="{{ b.aria_label | escape }}"><span class="img rec__logo img-bare aspect-[2/1] max-w-[120px] border border-dashed border-line-inverse [background:transparent] transition-colors duration-base group-hover:border-ink group-focus-visible:border-ink [&_.in]:p-[2px] [&_.lbl]:text-[10px] [&_.lbl]:tracking-[0.06em] [&_.lbl]:text-ink-muted [&_.dim]:sr-only" aria-hidden="true">{%- if b.image != blank -%}{{ b.image | image_url: width: 360 | image_tag: loading: 'lazy', class: 'absolute inset-0 size-full object-contain', alt: '' }}{%- else -%}<span class="in"><span class="lbl">{{ b.label | escape }}</span><span class="dim">{{ 'sections.logos.dim' | t }}</span></span>{%- endif -%}</span><span class="rec__tag text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-muted" aria-hidden="true">{{ b.tag | escape }}</span></a></li>
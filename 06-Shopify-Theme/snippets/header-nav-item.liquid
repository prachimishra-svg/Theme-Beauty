{%- assign key = link.title | handleize -%}
{%- assign is_current = false -%}
{%- if link.current or link.child_current -%}{%- assign is_current = true -%}{%- endif -%}
{%- if link.links.size > 0 -%}<div data-mega="{{ key }}" class="group/mega flex flex-col border-b border-line lg:border-0"><a href="{{ link.url }}"{% if is_current %} aria-current="page"{% endif %} data-mega-link aria-haspopup="true" aria-expanded="false" aria-controls="mega-{{ key }}" class="group relative flex min-h-[3.25rem] flex-1 items-center justify-between text-body-lg font-medium text-ink no-underline lg:min-h-touch lg:flex-none lg:text-body lg:after:absolute lg:after:inset-x-0 lg:after:bottom-2 lg:after:h-px lg:after:origin-left lg:after:scale-x-0 lg:after:bg-brand lg:after:transition-transform lg:hover:after:scale-x-100 lg:group-data-[open]/mega:after:scale-x-100{% if is_current %} lg:after:scale-x-100{% endif %}">{{ link.title | escape }}{% render 'icon', name: 'chevron-down', class: 'icon size-6 transition-transform duration-fast group-data-[open]/mega:rotate-180 lg:hidden' %}</a>{% render 'header-mega-menu', link: link, key: key, blocks: blocks %}</div>
{%- else -%}<div class="flex flex-col border-b border-line lg:border-0"><a href="{{ link.url }}"{% if is_current %} aria-current="page"{% endif %} class="group relative flex min-h-[3.25rem] flex-1 items-center justify-between text-body-lg font-medium text-ink no-underline lg:min-h-touch lg:flex-none lg:text-body lg:after:absolute lg:after:inset-x-0 lg:after:bottom-2 lg:after:h-px lg:after:origin-left lg:after:scale-x-0 lg:after:bg-brand lg:after:transition-transform lg:hover:after:scale-x-100{% if is_current %} lg:after:scale-x-100{% endif %}">{{ link.title | escape }}</a></div>
{%- endif -%}
{%- assign b = block.settings -%}<li class="hstep relative flex min-w-0 shrink-0 grow-0 basis-[78%] snap-start flex-col sm:max-lg:basis-[44%] lg:[&:nth-child(even)]:mt-[calc(var(--space-16)+var(--space-2))]" {{ block.shopify_attributes }}><div class="img img-bare aspect-[4/5] [background:var(--color-bg-page)] [&_.in]:gap-2 [&_.lbl]:text-[10px] [&_.lbl]:font-semibold [&_.lbl]:uppercase [&_.lbl]:tracking-[0.16em] [&_.lbl]:text-ink-muted [&_.dim]:text-caption [&_.dim]:text-ink-muted" aria-hidden="true">{%- if b.image != blank -%}{{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 1200', sizes: '(min-width: 1024px) 22vw, 78vw', class: 'absolute inset-0 size-full object-cover', alt: '' }}{%- else -%}<div class="in"><span class="lbl">{{ 'sections.ritual.step_image' | t }}</span><span class="dim">{{ 'sections.ritual.step_dim' | t: name: b.name }}</span></div>{%- endif -%}</div><span class="hstep__n relative z-[2] -mt-8 ml-4 block font-heading text-[56px] font-medium italic leading-[1] text-brand-secondary sm:-mt-10 sm:text-[68px] lg:-mt-12 lg:text-[80px]" aria-hidden="true">{{ number_label }}</span><h3 class="hstep__t mt-2 block font-heading text-[24px] font-medium leading-[1.2] text-ink"><span class="sr-only">{{ 'sections.ritual.step_sr' | t: number: number }}</span><span>{{ b.name | escape }}</span></h3>{%- if b.text != blank -%}<p class="hstep__d mt-2 block text-body-sm leading-[1.55] text-ink-secondary">{{ b.text | escape }}</p>{%- endif -%}<p class="hstep__meta mt-3 flex flex-wrap gap-x-4 gap-y-[2px] border-t border-[color-mix(in_srgb,var(--color-text-primary)_14%,transparent)] pt-3 text-caption text-ink-secondary"><span><b class="font-semibold text-ink">{{ 'sections.ritual.tip' | t }}</b> <span>{{ b.tip | escape }}</span></span><span><b class="font-semibold text-ink">{{ 'sections.ritual.time' | t }}</b> <span>{{ b.time | escape }}</span></span></p>{%- if b.product_label != blank -%}<a class="lnk mt-2 self-start" href="{{ b.product_link | default: b.product.url | default: '#' }}"><span>{{ b.product_label | escape }}</span> {% render 'icon', name: 'arrow-right', class: 'icon' %}</a>{%- endif -%}</li>
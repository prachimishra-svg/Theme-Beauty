{
    "name":  "Featured Collection",
    "wireframeOnly":  [
                          ".ann annotation block",
                          "data-section attribute",
                          "data-c hooks",
                          "sample products and their placeholder photos"
                      ],
    "page":  "homepage",
    "properties":  [
                       {
                           "name":  "heading",
                           "type":  "TEXT",
                           "default":  "Shop our favourites",
                           "scope":  "merchant",
                           "shopify":  {
                                           "param":  "heading",
                                           "id":  "heading",
                                           "setting":  "text"
                                       }
                       },
                       {
                           "name":  "anchor",
                           "type":  "TEXT",
                           "default":  "s06",
                           "scope":  "merchant",
                           "shopify":  {
                                           "param":  "anchor",
                                           "id":  "anchor",
                                           "setting":  "text"
                                       },
                           "note":  "In-page anchor id"
                       },
                       {
                           "name":  "buttonLabel",
                           "type":  "TEXT",
                           "default":  "View all best sellers",
                           "scope":  "merchant",
                           "shopify":  {
                                           "param":  "button_label",
                                           "id":  "button_label",
                                           "setting":  "text"
                                       }
                       },
                       {
                           "name":  "buttonHref",
                           "type":  "TEXT",
                           "default":  "#",
                           "scope":  "merchant",
                           "shopify":  {
                                           "param":  "button_href",
                                           "id":  "button_link",
                                           "setting":  "url"
                                       }
                       },
                       {

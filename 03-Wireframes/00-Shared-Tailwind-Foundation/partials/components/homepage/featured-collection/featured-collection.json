                                              "href"
                                          ],
                           "scope":  "parent",
                           "shopify":  {
                                           "param":  "products"
                                       },
                           "data":  "collection.products",
                           "pending":  true,
                           "note":  "Sample products standing in for the collection. In Shopify this is data from the chosen collection, never typed"
                       }
                   ],
    "tokens":  [
                   "page background",
                   "grid gap",
                   "type roles"
               ],
    "summary":  "Best sellers, new launches and sets as tabs over a product grid, with a View all button. Maps to the featured-collection section.",
    "accessibility":  "Heading is an h2; tabs follow the tab pattern; each card is one link.",
    "id":  "featured-collection",
    "shopifyOnly":  [
                        {
                            "id":  "products_to_show",
                            "setting":  "range",
                            "note":  "How many products the grid shows"
                        },
                        {
                            "id":  "collection",
                            "setting":  "collection",
                            "note":  "Per tab: the collection whose products fill the grid"
                        }
                    ],
    "level":  "main",
    "status":  "classified (D10 items pending)",
    "responsive":  "Two product columns below 768 px, four from 768 px.",
    "exposes":  [
                    {
                        "child":  "components/base/section-heading",
                        "property":  "title",
                        "via":  "heading"
                    },
                    {
                        "child":  "components/homepage/collection-tabs",
                        "property":  "tabs",
                        "via":  "tab blocks (label, collection)"
                    },
                    {
                        "child":  "components/base/button",
                        "property":  "label",
                        "via":  "buttonLabel"
                    },
                    {
                        "child":  "components/base/button",
                        "property":  "href",
                        "via":  "buttonHref"
                    }
                ],
    "children":  [
                     "components/base/section-heading",
                     "components/homepage/collection-tabs",
                     "components/homepage/product-card",
                     "components/base/button"
                 ]
}
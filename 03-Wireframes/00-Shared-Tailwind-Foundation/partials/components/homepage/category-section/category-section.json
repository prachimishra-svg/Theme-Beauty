  ],
  "children": ["components/base/section-heading", "components/homepage/category-card"],
  "exposes": [
    { "child": "components/homepage/category-card", "property": "layout", "via": "items.layout" },
    { "child": "components/homepage/category-card", "property": "href", "via": "items.href" },
    { "child": "components/homepage/category-card", "property": "title", "via": "items.title" },
    { "child": "components/homepage/category-card", "property": "subtitle", "via": "items.subtitle" },
    { "child": "components/homepage/category-card", "property": "linkText", "via": "items.linkText" },
    { "child": "components/base/section-heading", "property": "title", "via": "heading" }
